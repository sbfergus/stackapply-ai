generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  fullName           String?
  avatarUrl          String?
  resumeUrl          String?
  linkedinUrl        String?
  linkedinData       Json?
  linkedinSyncedAt   DateTime?
  baseResumeText     String?
  baseCoverLetter    String?
  writingStyle       Json?
  preferredWorkTypes WorkType[]          @default([REMOTE, HYBRID])
  preferredTechStack String[]
  targetSalaryMin    Int?
  preferredLocations String[]
  apiKeyProvider     ApiKeyProvider?
  apiKeyEncrypted    String?
  aiAnalysisCount    Int                 @default(0)
  lastAiAnalysisReset DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  password           String?
  jobs               Job[]
  extensionSessions  ExtensionSession[]
}

model ExtensionSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([token])
}

model Job {
  id                 String    @id @default(uuid())
  userId             String
  title              String
  company            String
  location           String
  workSetting        WorkType  @default(HYBRID)
  salaryMin          Int?
  salaryMax          Int?
  sources            String[]
  originalUrls       String[]
  companyOverview    String
  roleSummary        String
  techStack          String[]
  benefits           Json
  status             JobStatus @default(TO_REVIEW)
  matchScore         Int?
  preferenceScore    Int?
  matchReasoning     String?
  tailoredResumeText String?
  coverLetterText    String?
  appliedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  notes              String?
  listedAt           DateTime?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum WorkType {
  REMOTE
  HYBRID
  IN_OFFICE
}

enum JobStatus {
  TO_REVIEW
  READY_TO_APPLY
  APPLIED
  INTERVIEWING
  REJECTED
  OFFER
}

enum ApiKeyProvider {
  ANTHROPIC
  OPENAI
}
