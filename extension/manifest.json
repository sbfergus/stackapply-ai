{
  "manifest_version": 3,
  "name": "StackApply AI - Job Saver",
  "version": "1.1.0",
  "description": "Instantly save job postings from LinkedIn and web pages to your StackApply AI dashboard.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to StackApply AI"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}